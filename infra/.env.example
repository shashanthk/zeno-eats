# MariaDB — restaurant-service
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Redis
REDIS_PASSWORD=

# restaurant-service datasource (read by application.yaml)
DB_URL=jdbc:mariadb://localhost:3306/zeno_eats_db
DB_USERNAME=zeno_app_user
DB_PASSWORD=

# PostgreSQL — user-service
USER_DB_NAME=zeno_users_db
USER_DB_USERNAME=zeno_user_app
USER_DB_PASSWORD=

# user-service datasource (read by application.yaml)
USER_DB_URL=jdbc:postgresql://localhost:5432/zeno_users_db

# JWT — RS256 key pair (Base64-encoded DER format)
# Generate with Git Bash / WSL / macOS Terminal:
#
#   openssl genrsa -out jwt_private.pem 2048
#   openssl pkcs8 -topk8 -nocrypt -in jwt_private.pem -outform DER | base64 -w 0   -> JWT_PRIVATE_KEY
#   openssl rsa -in jwt_private.pem -pubout -outform DER | base64 -w 0              -> JWT_PUBLIC_KEY
#
# Keep jwt_private.pem local — never commit it.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRATION_MS=86400000
