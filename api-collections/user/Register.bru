meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{USER_BASE_URL}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "firstName": "John",
    "lastName": "Doe",
    "email": "john.doe@example.com",
    "password": "password123"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("AUTH_TOKEN", res.body.data.token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
